# Database (Neon free tier - https://neon.tech)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Admin auth
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-please"
SESSION_SECRET="generate-a-long-random-string-here"

# Slack (https://api.slack.com/apps) — preferred channel for "task assigned" DMs
SLACK_BOT_TOKEN="xoxb-..."

# Google OAuth (https://console.cloud.google.com) — used for the Gmail Inbox
# triage feature. Configure an OAuth 2.0 client (web application) with the
# redirect URI set to: <NEXT_PUBLIC_APP_URL>/api/gmail/oauth/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend (https://resend.com) — fallback when an assignee has no Slack ID
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Project Manager <noreply@yourdomain.com>"

# App URL (used in notification links for collaborators)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Netlify Blobs - automatically injected on Netlify; for local dev set:
# NETLIFY_BLOBS_CONTEXT can be left unset; falls back to local filesystem
