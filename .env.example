# Database (Postgres - es. Neon, Supabase, Railway)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Token segreto admin: la prima persona che apre /setup con questo token diventa admin
# Genera un valore casuale lungo (es. con `openssl rand -hex 32`)
ADMIN_SETUP_TOKEN="cambia-questo-token-segreto-molto-lungo"

# Resend API key per le email (https://resend.com - free tier 100/giorno)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Progetti <onboarding@resend.dev>"

# URL pubblico dell'app (usato nei link delle email)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
