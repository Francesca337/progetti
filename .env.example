# Database (Neon free tier - https://neon.tech)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Admin auth
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-please"
SESSION_SECRET="generate-a-long-random-string-here"

# Resend (https://resend.com)
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Project Manager <noreply@yourdomain.com>"

# App URL (used in emails for collaborator magic links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Netlify Blobs - automatically injected on Netlify; for local dev set:
# NETLIFY_BLOBS_CONTEXT can be left unset; falls back to local filesystem
