// Project Management App - Prisma schema
// Database: PostgreSQL (Neon free tier)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

enum Role {
  ADMIN
  COLLABORATOR
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  TODO          // Da fare
  IN_PROGRESS   // In corso
  IN_REVIEW     // In revisione
  DONE          // Completata
}

enum InboxSource {
  GMAIL
  SLACK
}

enum InboxStatus {
  PENDING
  ARCHIVED
  CONVERTED
}

// The PM (admin) and the collaborators all live in this table.
// The admin row exists once (seeded from ADMIN_EMAIL env var on first login).
// Collaborators authenticate via a personal magic-link token (no password).
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  role         Role     @default(COLLABORATOR)
  accessToken  String?  @unique // personal link token for collaborators
  passwordHash String?  // scrypt hash; only set for DB-managed admins
  slackUserId  String?  // Slack member ID for DM notifications (e.g. U01ABCDEF)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tasksAssigned    Task[]            @relation("TaskAssignees")
  projects         Project[]         @relation("ProjectOwner")
  projectNotes     ProjectNote[]     @relation("ProjectNoteAuthor")
  gmailIntegration GmailIntegration?
  inboxItems       InboxItem[]       @relation("UserInbox")

  @@index([role])
}

// Projects group tasks. The admin owns all projects.
// `isPersonalBacklog = true` flags the special "personal backlog" buckets
// that only the admin sees; their tasks are not assigned to collaborators.
model Project {
  id                String   @id @default(cuid())
  name              String
  description       String?
  color             String   @default("#3566f5")
  isPersonalBacklog Boolean  @default(false)
  ownerId           String
  owner             User     @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  archived          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tasks Task[]
  notes ProjectNote[]

  @@index([ownerId])
  @@index([archived])
}

model Task {
  id                String     @id @default(cuid())
  title             String
  description       String?    // also used for "expected output"
  deadline          DateTime?
  priority          Priority   @default(MEDIUM)
  status            TaskStatus @default(TODO)

  // Optional reference folder (Drive, Dropbox, …). Shown on the task
  // so the collaborator knows where to drop or fetch materials.
  driveFolderUrl    String?

  // True when a collaborator self-created the task as part of their
  // personal backlog. Hidden from every admin view.
  isPrivate         Boolean    @default(false)

  projectId  String
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // One task can be assigned to zero, one, or many users. Backlog tasks
  // have zero assignees. Notification fanout iterates over this list.
  assignees  User[]  @relation("TaskAssignees")

  attachments Attachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([deadline])
  @@index([isPrivate])
}

model Attachment {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  filename    String
  mimeType    String
  sizeBytes   Int
  blobKey     String   // key inside the Netlify Blobs store
  uploadedBy  String   // userId of uploader
  createdAt   DateTime @default(now())

  @@index([taskId])
}

// One row per admin who has connected Gmail. The refresh token is
// AES-encrypted with SESSION_SECRET (see lib/secret-box.ts).
model GmailIntegration {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email        String    // Gmail address that authorized
  refreshToken String    // encrypted blob
  labelName    String    @default("PM-todo")
  labelId      String?   // resolved Gmail label ID, looked up on first sync
  lastSyncAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Triage queue: rows pulled from Gmail (and later Slack) waiting to be
// reviewed and either converted into a real Task or archived.
model InboxItem {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation("UserInbox", fields: [userId], references: [id], onDelete: Cascade)
  source          InboxSource
  sourceId        String      // Gmail message ID (or future Slack ts)
  title           String
  description     String?
  sender          String?
  link            String?
  status          InboxStatus @default(PENDING)
  convertedTaskId String?     @unique
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([userId, source, sourceId])
  @@index([userId, status])
}

// Per-admin private notes scoped to a project. Visible only to the
// admin who wrote them; never surfaced to collaborators.
model ProjectNote {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("ProjectNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, authorId])
}
